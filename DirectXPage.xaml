<Page
    x:Class="Qemu_UWP_host.DirectXPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Qemu_UWP_host"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

  <Page.Resources>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F01F1F1F" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#CC141414" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="SectionLineBrush" Color="#FF5F6368" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF00C853" />
  </Page.Resources>

  <Grid Background="Black">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <CommandBar
        x:Name="bottomAppBar"
        Grid.Row="0"
        Height="56"
        Background="{StaticResource HeaderBackgroundBrush}"
        Foreground="White"
        HorizontalContentAlignment="Right">
      <CommandBar.Content>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <FontIcon Glyph="&#xE768;" Foreground="{StaticResource AccentBrush}" FontSize="22" />
          <StackPanel>
            <TextBlock Text="QEMU UWP Host" Foreground="White" FontWeight="SemiBold" />
            <TextBlock
                x:Name="statusText"
                Text="Select boot media, review qemu_cmd_line, then start."
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                MaxWidth="720" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
            <FontIcon x:Name="keyboardCaptureIcon" Glyph="&#xE765;" Foreground="{StaticResource AccentBrush}" FontSize="18" />
            <FontIcon x:Name="mouseCaptureIcon" Glyph="&#xE962;" Foreground="{StaticResource AccentBrush}" FontSize="18" />
          </StackPanel>
        </StackPanel>
      </CommandBar.Content>
      <CommandBar.PrimaryCommands>
        <AppBarButton x:Name="showTabsButton" Icon="Setting" Label="Hide tabs" Click="ShowTabsButton_Click" Foreground="White" />
        <AppBarButton x:Name="startButton" Icon="Play" Label="Start" Click="StartButton_Click" Foreground="White" />
        <AppBarButton x:Name="pauseButton" Icon="Pause" Label="Pause" Click="PauseButton_Click" Foreground="White" IsEnabled="False" IsTabStop="False" />
        <AppBarButton x:Name="resumeButton" Icon="Play" Label="Resume" Click="ResumeButton_Click" Foreground="White" IsEnabled="False" IsTabStop="False" />
        <AppBarButton x:Name="stopButton" Icon="Stop" Label="Stop" Click="StopButton_Click" Foreground="White" IsEnabled="False" IsTabStop="False" />
        <AppBarButton x:Name="shutdownButton" Label="Shutdown" Click="ShutdownButton_Click" Foreground="White" IsEnabled="False" IsTabStop="False">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE7E8;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </CommandBar.PrimaryCommands>
    </CommandBar>

    <Grid Grid.Row="1" Background="Black">
      <SwapChainPanel x:Name="swapChainPanel" />

      <Grid x:Name="readyOverlay" IsHitTestVisible="False" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="QEMU Host Ready" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Choose media, review qemu_cmd_line, then press Start." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
          <FontIcon Glyph="&#xE768;" Foreground="White" FontSize="56" HorizontalAlignment="Center" Opacity="0.95" />
        </StackPanel>
      </Grid>

      <Grid x:Name="rfbRuntimeOverlay" Background="Black" IsHitTestVisible="False" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="RFB server" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="rfbRuntimeStatusText" Text="RFB server: disabled" Foreground="{StaticResource MutedTextBrush}" FontSize="15" TextWrapping="WrapWholeWords" TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <ScrollViewer
          x:Name="topPanel"
          Background="{StaticResource PanelBackgroundBrush}"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
<Pivot x:Name="tabPanel" Grid.Row="0" Foreground="White" Background="Transparent">
            <PivotItem AutomationProperties.Name="Boot">
              <PivotItem.Header>
                <SymbolIcon Symbol="Play" />
              </PivotItem.Header>
              <StackPanel Padding="16,14,16,20" Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock Text="Boot" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="Choose media and review the generated QEMU host command before starting." Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>

                <TextBlock Text="MEDIA" Foreground="White" FontWeight="SemiBold" />
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SectionLineBrush}" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Drive media" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="RAW, QCOW, VDI, VMDK, VHD/VHDX, DMG, QED or qemu_cmd_line" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="selectedDriveText" Text="No drive selected" Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords" />
                        <ComboBox x:Name="driveMediaHistoryBox" Header="Used drive media" PlaceholderText="Select from boot_media" HorizontalAlignment="Stretch" SelectionChanged="DriveMediaHistory_SelectionChanged" />
                      </StackPanel>
                      <AppBarButton Grid.Column="2" Icon="OpenFile" Label="Select drive" Click="SelectDriveButton_Click" Foreground="White" />
                      <AppBarButton Grid.Column="3" Icon="Delete" Label="Remove drive" Click="RemoveDriveButton_Click" Foreground="White" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="CD-ROM media" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="ISO, raw or QEMU image mounted as CD-ROM" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="selectedCdromText" Text="No CD-ROM selected" Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords" />
                        <ComboBox x:Name="cdromMediaHistoryBox" Header="Used CD-ROM media" PlaceholderText="Select from boot_media" HorizontalAlignment="Stretch" SelectionChanged="CdromMediaHistory_SelectionChanged" />
                      </StackPanel>
                      <AppBarButton Grid.Column="2" Icon="OpenFile" Label="Select CD-ROM" Click="SelectCdromButton_Click" Foreground="White" />
                      <AppBarButton Grid.Column="3" Icon="Delete" Label="Remove CD-ROM" Click="RemoveCdromButton_Click" Foreground="White" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Shared folder" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="VVFAT is currently disabled" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="selectedSharedFolderText" Text="No shared folder selected" Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords" />
                        <ComboBox x:Name="sharedFolderModeBox" Header="VVFAT mode" SelectedIndex="0" Width="220" HorizontalAlignment="Left" IsEnabled="False" SelectionChanged="SharedFolderMode_Changed">
                          <ComboBoxItem Content="Read/write" Tag="rw" />
                          <ComboBoxItem Content="Read-only" Tag="ro" />
                        </ComboBox>
                      </StackPanel>
                      <AppBarButton Grid.Column="2" Icon="Folder" Label="Select folder" IsEnabled="False" Click="SelectSharedFolderButton_Click" Foreground="White" />
                      <AppBarButton Grid.Column="3" Icon="Delete" Label="Remove folder" IsEnabled="False" Click="ClearSharedFolderButton_Click" Foreground="White" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Boot device" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <ComboBox x:Name="bootDeviceBox" Grid.Column="1" Header="Boot device" SelectedIndex="0" Width="220" HorizontalAlignment="Left" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="none" />
                        <ComboBoxItem Content="Drive" />
                        <ComboBoxItem Content="CD-ROM" />
                      </ComboBox>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                        <TextBlock x:Name="bootMediaSizeText" Text="boot_media: 0 B" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <Button x:Name="clearBootMediaButton" Content="Clear boot_media" Click="ClearBootMediaButton_Click" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="10" RowSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <ComboBox x:Name="bootModeBox" Header="Boot order mode" Grid.Row="0" Grid.Column="0" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Simple c/d" Tag="simple" />
                        <ComboBoxItem Content="Advanced order" Tag="order" />
                        <ComboBoxItem Content="Once only" Tag="once" />
                      </ComboBox>
                      <ComboBox x:Name="bootOrderBox" Header="Boot order" Grid.Row="0" Grid.Column="1" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Auto" Tag="" />
                        <ComboBoxItem Content="Drive then CD-ROM" Tag="cd" />
                        <ComboBoxItem Content="CD-ROM then Drive" Tag="dc" />
                        <ComboBoxItem Content="Network then Drive" Tag="nc" />
                      </ComboBox>
                      <ComboBox x:Name="bootMenuBox" Header="Boot menu" Grid.Row="0" Grid.Column="2" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Default" Tag="" />
                        <ComboBoxItem Content="On" Tag="on" />
                        <ComboBoxItem Content="Off" Tag="off" />
                      </ComboBox>
                      <ComboBox x:Name="diskInterfaceBox" Header="Disk interface" Grid.Row="1" Grid.Column="0" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Profile/default" Tag="default" />
                        <ComboBoxItem Content="IDE" Tag="ide" />
                        <ComboBoxItem Content="VirtIO" Tag="virtio" />
                        <ComboBoxItem Content="SCSI" Tag="scsi" />
                        <ComboBoxItem Content="SATA/AHCI" Tag="sata" />
                      </ComboBox>
                      <ComboBox x:Name="diskFormatBox" Header="Disk format" Grid.Row="1" Grid.Column="1" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Auto" Tag="" />
                        <ComboBoxItem Content="raw" Tag="raw" />
                        <ComboBoxItem Content="qcow" Tag="qcow" />
                        <ComboBoxItem Content="qcow2" Tag="qcow2" />
                        <ComboBoxItem Content="qed" Tag="qed" />
                        <ComboBoxItem Content="vdi" Tag="vdi" />
                        <ComboBoxItem Content="vmdk" Tag="vmdk" />
                        <ComboBoxItem Content="vpc/vhd" Tag="vpc" />
                        <ComboBoxItem Content="vhdx" Tag="vhdx" />
                        <ComboBoxItem Content="bochs" Tag="bochs" />
                        <ComboBoxItem Content="cloop" Tag="cloop" />
                        <ComboBoxItem Content="dmg" Tag="dmg" />
                        <ComboBoxItem Content="parallels" Tag="parallels" />
                        <ComboBoxItem Content="vvfat" Tag="vvfat" />
                      </ComboBox>
                      <ComboBox x:Name="driveCacheBox" Header="Drive cache" Grid.Row="1" Grid.Column="2" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Default" Tag="" />
                        <ComboBoxItem Content="writeback" Tag="writeback" />
                        <ComboBoxItem Content="writethrough" Tag="writethrough" />
                        <ComboBoxItem Content="none" Tag="none" />
                        <ComboBoxItem Content="unsafe" Tag="unsafe" />
                      </ComboBox>
                      <ComboBox x:Name="driveModeBox" Header="Image mode" Grid.Row="1" Grid.Column="3" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Writable" Tag="writable" />
                        <ComboBoxItem Content="Read-only" Tag="readonly" />
                        <ComboBoxItem Content="Snapshot" Tag="snapshot" />
                      </ComboBox>
                      <ComboBox x:Name="cdromFormatBox" Header="CD-ROM format" Grid.Row="2" Grid.Column="0" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Auto" Tag="" />
                        <ComboBoxItem Content="raw" Tag="raw" />
                        <ComboBoxItem Content="qcow" Tag="qcow" />
                        <ComboBoxItem Content="qcow2" Tag="qcow2" />
                        <ComboBoxItem Content="qed" Tag="qed" />
                        <ComboBoxItem Content="vdi" Tag="vdi" />
                        <ComboBoxItem Content="vmdk" Tag="vmdk" />
                        <ComboBoxItem Content="vpc/vhd" Tag="vpc" />
                        <ComboBoxItem Content="vhdx" Tag="vhdx" />
                        <ComboBoxItem Content="bochs" Tag="bochs" />
                        <ComboBoxItem Content="cloop" Tag="cloop" />
                        <ComboBoxItem Content="dmg" Tag="dmg" />
                        <ComboBoxItem Content="parallels" Tag="parallels" />
                        <ComboBoxItem Content="vvfat" Tag="vvfat" />
                      </ComboBox>
                      <TextBlock x:Name="mediaDetectionText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="Detected media settings: none" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" VerticalAlignment="Bottom" />
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="RFB SERVER" Foreground="White" FontWeight="SemiBold" />
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SectionLineBrush}" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10" RowSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="rfbServerBox" Header="RFB / VNC display" Grid.Column="0" SelectedIndex="0" SelectionChanged="RfbServer_Changed">
                        <ComboBoxItem Content="Disabled, use host display" Tag="off" />
                        <ComboBoxItem Content="Enabled, expose RFB server" Tag="on" />
                      </ComboBox>
                      <TextBox x:Name="rfbPortBox" Header="External port" Grid.Column="1" Text="5900" TextChanged="RfbPort_TextChanged" />
                      <TextBlock x:Name="rfbStatusText" Grid.Column="2" Text="RFB server: disabled" Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="When enabled, the app shows only the RFB IP, port and connection status while the emulator screen is exposed to external VNC clients." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </Border>

                <TextBlock Text="FIRMWARE AND DIRECT KERNEL BOOT" Foreground="White" FontWeight="SemiBold" />
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SectionLineBrush}" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10" RowSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <ComboBox x:Name="firmwareBox" Header="Firmware mode" Grid.Row="0" Grid.Column="0" SelectedIndex="0" SelectionChanged="BootDevice_Changed">
                        <ComboBoxItem Content="Profile/default" Tag="default" />
                        <ComboBoxItem Content="Legacy BIOS" Tag="legacy" />
                        <ComboBoxItem Content="UEFI" Tag="uefi" />
                        <ComboBoxItem Content="Secure UEFI" Tag="secure-uefi" />
                      </ComboBox>
                      <ComboBox x:Name="firmwareFileBox" Header="BIOS / firmware" Grid.Row="0" Grid.Column="1" PlaceholderText="Select packaged or boot_media file" SelectionChanged="DirectBootFile_SelectionChanged" />
                      <TextBox x:Name="firmwarePathBox" Header="Manual BIOS / firmware path" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="NoWrap" TextChanged="DirectBootText_Changed" />
                      <Button x:Name="clearFirmwareButton" Content="Clear BIOS / firmware" Grid.Row="1" Grid.Column="2" Margin="8,24,0,0" Click="ClearFirmwareButton_Click" />

                      <ComboBox x:Name="kernelFileBox" Header="Kernel" Grid.Row="2" Grid.Column="0" PlaceholderText="Select packaged or boot_media file" SelectionChanged="DirectBootFile_SelectionChanged" />
                      <TextBox x:Name="kernelPathBox" Header="Manual kernel path" Grid.Row="2" Grid.Column="1" TextWrapping="NoWrap" TextChanged="DirectBootText_Changed" />
                      <Button x:Name="clearKernelButton" Content="Clear Kernel" Grid.Row="2" Grid.Column="2" Margin="8,24,0,0" Click="ClearKernelButton_Click" />

                      <ComboBox x:Name="initrdFileBox" Header="Initrd" Grid.Row="3" Grid.Column="0" PlaceholderText="Select packaged or boot_media file" SelectionChanged="DirectBootFile_SelectionChanged" />
                      <TextBox x:Name="initrdPathBox" Header="Manual initrd path" Grid.Row="3" Grid.Column="1" TextWrapping="NoWrap" TextChanged="DirectBootText_Changed" />
                      <Button x:Name="clearInitrdButton" Content="Clear Initrd" Grid.Row="3" Grid.Column="2" Margin="8,24,0,0" Click="ClearInitrdButton_Click" />

                      <ComboBox x:Name="dtbFileBox" Header="DTB" Grid.Row="4" Grid.Column="0" PlaceholderText="Select packaged or boot_media file" SelectionChanged="DirectBootFile_SelectionChanged" />
                      <TextBox x:Name="dtbPathBox" Header="Manual DTB path" Grid.Row="4" Grid.Column="1" TextWrapping="NoWrap" TextChanged="DirectBootText_Changed" />
                      <Button x:Name="clearDtbButton" Content="Clear DTB" Grid.Row="4" Grid.Column="2" Margin="8,24,0,0" Click="ClearDtbButton_Click" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="kernelAppendBox" Header="Kernel append" PlaceholderText="root=/dev/sda1 console=ttyS0" TextWrapping="NoWrap" TextChanged="DirectBootText_Changed" />
                      <Button x:Name="clearKernelAppendButton" Grid.Column="1" Content="Clear Kernel append" Margin="8,24,0,0" Click="ClearKernelAppendButton_Click" />
                    </Grid>
                    <TextBox x:Name="shadps4TitleIdBox" Header="ShadPS4 Title ID" PlaceholderText="CUSA02456 (used only by the shadps4 target)" TextWrapping="NoWrap" TextChanged="DirectBootText_Changed" />
                    <ComboBox x:Name="shadps4VariantBox" Header="ShadPS4 console variant" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                      <ComboBoxItem Content="PS4 Liverpool / Base" Tag="base" />
                      <ComboBoxItem Content="PS4 Pro / Neo" Tag="neo" />
                    </ComboBox>
                    <TextBlock Text="Selectors are populated from packaged qemu files and LocalFolder\\boot_media. Manual paths remain editable for advanced cases." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </Border>

                <TextBlock Text="MACHINE" Foreground="White" FontWeight="SemiBold" />
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SectionLineBrush}" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Architecture" Foreground="White" FontWeight="SemiBold" />
                      <ComboBox x:Name="architectureBox" Header="QEMU target" SelectedIndex="0" Width="220" HorizontalAlignment="Left" SelectionChanged="Architecture_Changed">
                        <ComboBoxItem Content="x86_64" />
                        <ComboBoxItem Content="i386" />
                      </ComboBox>
                      <StackPanel x:Name="targetLoadingPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <ProgressBar x:Name="targetLoadingBar" Width="180" Height="4" IsIndeterminate="True" />
                        <TextBlock x:Name="targetLoadingText" Text="Loading target options..." Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Text="Memory" Foreground="White" FontWeight="SemiBold" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="memorySlider" Minimum="0" Maximum="8192" Value="512" StepFrequency="16" TickFrequency="1024" Foreground="{StaticResource AccentBrush}" ValueChanged="MemorySlider_ValueChanged" />
                        <TextBlock x:Name="memoryValueText" Grid.Column="1" Text="512 MB" Foreground="White" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="The command uses the selected display profile and disables host audio for now. 0 MB uses the QEMU default memory." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="QEMU selectors" Foreground="White" FontWeight="SemiBold" />
                      <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="machineSelectorBox" Header="Machine" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="cpuSelectorBox" Header="CPU" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="deviceSelectorBox" Header="Device" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="vgaSelectorBox" Header="VGA" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="monitorSelectorBox" Header="Monitor" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="netdevSelectorBox" Header="Netdev" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                      </Grid>
                      <TextBlock Text="Options are filtered from strings found in the packaged DLL for the selected QEMU target." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="Practical machine options" Foreground="White" FontWeight="SemiBold" />
                      <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="smpSelectorBox" Header="SMP" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                          <ComboBoxItem Content="1 CPU" Tag="1" />
                          <ComboBoxItem Content="2 CPUs" Tag="2" />
                          <ComboBoxItem Content="4 CPUs" Tag="4" />
                          <ComboBoxItem Content="8 CPUs" Tag="8" />
                        </ComboBox>
                        <ComboBox x:Name="rtcSelectorBox" Header="RTC" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                          <ComboBoxItem Content="Auto" Tag="" />
                          <ComboBoxItem Content="UTC" Tag="base=utc" />
                          <ComboBoxItem Content="Local time" Tag="base=localtime" />
                          <ComboBoxItem Content="Local time + driftfix" Tag="base=localtime,driftfix=slew" />
                        </ComboBox>
                        <ComboBox x:Name="rebootBehaviorBox" Header="Reboot behavior" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                          <ComboBoxItem Content="Auto" Tag="" />
                          <ComboBoxItem Content="No reboot" Tag="-no-reboot" />
                          <ComboBoxItem Content="No shutdown" Tag="-no-shutdown" />
                          <ComboBoxItem Content="No reboot or shutdown" Tag="-no-reboot -no-shutdown" />
                        </ComboBox>
                        <ComboBox x:Name="acpiSelectorBox" Header="ACPI" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                          <ComboBoxItem Content="Auto" Tag="" />
                          <ComboBoxItem Content="On" Tag="acpi=on" />
                          <ComboBoxItem Content="Off" Tag="acpi=off" />
                        </ComboBox>
                        <ComboBox x:Name="hpetSelectorBox" Header="HPET" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                          <ComboBoxItem Content="Auto" Tag="" />
                          <ComboBoxItem Content="On" Tag="hpet=on" />
                          <ComboBoxItem Content="Off" Tag="hpet=off" />
                        </ComboBox>
                        <ComboBox x:Name="vmportSelectorBox" Header="VMPort" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                          <ComboBoxItem Content="Auto" Tag="" />
                          <ComboBoxItem Content="On" Tag="vmport=on" />
                          <ComboBoxItem Content="Off" Tag="vmport=off" />
                        </ComboBox>
                        <ComboBox x:Name="usbBusSelectorBox" Header="USB bus" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="QemuSelector_Changed">
                          <ComboBoxItem Content="Auto" Tag="" />
                          <ComboBoxItem Content="Enable legacy USB" Tag="on" />
                          <ComboBoxItem Content="Disable USB" Tag="usb=off" />
                        </ComboBox>
                        <ComboBox x:Name="usbControllerSelectorBox" Header="USB controller" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="inputDeviceSelectorBox" Header="Input device" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="networkDeviceSelectorBox" Header="Network model" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                        <ComboBox x:Name="audioDeviceSelectorBox" Header="Audio model" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="QemuSelector_Changed" />
                      </Grid>
                      <TextBlock Text="These controls cover common compatibility fixes. SMP defaults to 1; target-specific devices are filtered from the selected QEMU DLL." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="argumentsHelpButton"
                            Grid.Row="0"
                            Text="?"
                            Foreground="{StaticResource AccentBrush}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            PointerEntered="ArgumentsHelpButton_PointerEntered"
                            PointerExited="ArgumentsHelpButton_PointerExited" />
                        <Border
                            x:Name="argumentsHelpPanel"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Background="#EE1F1F1F"
                            BorderBrush="{StaticResource SectionLineBrush}"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,2,0,6"
                            PointerEntered="ArgumentsHelpButton_PointerEntered"
                            PointerExited="ArgumentsHelpButton_PointerExited">
                          <TextBlock Foreground="White" TextWrapping="WrapWholeWords">
                            <Run Text="Common extra arguments: " />
                            <Run Text="-machine, -M, -cpu, -smp, -vga, -device, -netdev, -nic, -usb, -rtc, -serial, -parallel, -monitor, -no-acpi, -no-reboot. " />
                            <Run Text="The app already generates display, audio, memory, media, and boot order." />
                          </TextBlock>
                        </Border>
                        <Grid Grid.Row="2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox x:Name="extraArgumentsBox" Header="Additional QEMU arguments" PlaceholderText="-vga std -no-reboot" TextWrapping="NoWrap" />
                          <Button Grid.Column="1" Content="Update qemu commands" Margin="10,24,0,0" Click="UpdateCommandLineButton_Click" />
                        </Grid>
                      </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Text="Profiles" Foreground="White" FontWeight="SemiBold" />
                      <ComboBox x:Name="diagnosticProfileBox" Header="QEMU startups" SelectedIndex="0" Width="360" HorizontalAlignment="Left" SelectionChanged="DiagnosticProfile_Changed">
                        <ComboBoxItem Content="Normal command" />
                        <ComboBoxItem Content="Video only no media" />
                        <ComboBoxItem Content="Linux cloud UEFI qcow2" />
                        <ComboBoxItem Content="Windows 98" />
                        <ComboBoxItem Content="Windows XP" />
                        <ComboBoxItem Content="Windows 7" />
                      </ComboBox>
                      <TextBlock Text="Profiles add conservative target-aware machine, CPU, video, mouse and boot options. Normal command keeps the selected target defaults, and Video only no media tests host display without a disk." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </PivotItem>

            <PivotItem AutomationProperties.Name="Errors">
              <PivotItem.Header>
                <SymbolIcon Symbol="Comment" />
              </PivotItem.Header>
              <StackPanel Padding="16,14,16,24" Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Errors" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="Runtime and configuration problems are collected here." Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="detectTargetsButton" Content="Inspect QEMU host API" Click="DetectTargetsButton_Click" />
                  <Button x:Name="testPackagedDllsButton" Content="Test packaged DLLs" Click="TestPackagedDllsButton_Click" />
                  <Button x:Name="clearErrorsButton" Content="Clear errors" Click="ClearErrorsButton_Click" />
                </StackPanel>
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SectionLineBrush}" BorderThickness="1" Padding="12">
                  <TextBox x:Name="errorLogBox" Text="No errors recorded." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="520" HorizontalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>
              </StackPanel>
            </PivotItem>

            <PivotItem AutomationProperties.Name="qemu commands">
              <PivotItem.Header>
                <SymbolIcon Symbol="Page" />
              </PivotItem.Header>
              <StackPanel Padding="16,14,16,24" Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="qemu commands" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="Review or edit the command intended for the selected qemu-system target." Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="resetCommandsButton" Content="Reset to startup defaults" Click="ResetCommandsButton_Click" />
                  <Button x:Name="alignCommandsButton" Content="Align commands vertically" Click="AlignCommandsButton_Click" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="Color preview" Foreground="White" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Automatic/app-selected" Foreground="#FF66D9EF" />
                    <TextBlock Text="Additional QEMU arguments" Foreground="#FFFFCC66" />
                  </StackPanel>
                  <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SectionLineBrush}" BorderThickness="1" Padding="10">
                    <RichTextBlock x:Name="commandPreviewBlock" FontFamily="Consolas" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SectionLineBrush}" BorderThickness="1" Padding="12">
                  <TextBox x:Name="commandLineBox" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="520" Header="Generated command" PlaceholderText="The generated qemu command will appear here." ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="CommandLineBox_TextChanged" />
                </Border>
              </StackPanel>
            </PivotItem>
          </Pivot>
        </Grid>
      </ScrollViewer>

      <Border
          x:Name="virtualKeyboardOverlay"
          Background="#99000000"
          BorderBrush="#66FFFFFF"
          BorderThickness="1"
          CornerRadius="6"
          Padding="8"
          Margin="18"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Bottom"
          IsHitTestVisible="False"
          Visibility="Collapsed">
        <StackPanel Spacing="6">
          <TextBlock
              Text="Virtual keyboard"
              Foreground="White"
              FontSize="13"
              FontWeight="SemiBold"
              Opacity="0.85" />
          <Grid x:Name="virtualKeyboardGrid" ColumnSpacing="2" RowSpacing="2" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>





